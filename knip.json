{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "electron/main.ts",
    "electron/preload.ts",
    "src/test/**/*.test.ts",
    "scripts/*.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "electron/**/*.ts"
  ],
  "ignore": [
    "src/electron.d.ts"
  ],
  "ignoreDependencies": [
    "tailwindcss"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
