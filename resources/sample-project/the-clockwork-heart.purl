    {
      "id": "sc_give_gift",
      "name": "GiveGift",
      "tags": [
        "func"
      ],
      "blocks": [
        {
          "id": "b_gg_aff",
          "type": "variable-set",
          "variableId": "var_affection",
          "operator": "+=",
          "value": "10"
        },
        {
          "id": "b_gg_remove_gear",
          "type": "raw",
          "code": "<<tgInvRemove $traveler \"gear\" 1>>"
        },
        {
          "id": "b_gg_text",
          "type": "text",
          "content": "Elara turns the gear over, eyes bright. \"Where did you—? Never mind. //Thank you.//\""
        }
      ]
    },
    {
      "id": "sc_give_rose",
      "name": "GiveRose",
      "tags": [
        "func"
      ],
      "blocks": [
        {
          "id": "b_gr_aff",
          "type": "variable-set",
          "variableId": "var_affection",
          "operator": "+=",
          "value": "20"
        },
        {
          "id": "b_gr_set_gave",
          "type": "variable-set",
          "variableId": "var_gave_rose",
          "operator": "=",
          "value": "true"
        },
        {
          "id": "b_gr_remove_rose",
          "type": "raw",
          "code": "<<tgInvRemove $traveler \"rose\" 1>>\n<<set $traveler.equipment.trinket to \"\">>"
        },
        {
          "id": "b_gr_dlg",
          "type": "dialogue",
          "characterId": "char_elara",
          "text": "Elara gasps, her fingers gently tracing the brass petals. \"A clockwork rose... I thought these were lost when the Great Foundry burned. It's beautiful... thank you.\"",
          "align": "left"
        }
      ]
    },
    {
      "id": "sc_use_tonic",
      "name": "tg_use_tonic",
      "tags": [
        "func"
      ],
      "blocks": [
        {
          "id": "b_ut_text",
          "type": "text",
          "content": "You uncork the tonic and drink. Warmth spreads through your fingers."
        }
      ]
    },
    {
      "id": "sc_pop_welcome",
      "name": "PopupWelcome",
      "tags": [
        "popup"
      ],
      "blocks": [
        {
          "id": "b_pw_text",
          "type": "text",
          "content": "Welcome to **The Clockwork Heart** — a tiny demo built to show off Purl. Explore freely; nothing here can break."
        }
      ]
    },
    {
      "id": "sc_pop_help",
      "name": "PopupHelp",
      "tags": [
        "popup"
      ],
      "blocks": [
        {
          "id": "b_ph_text",
          "type": "text",
          "content": "Gifting the **Copper Gear** to Elara in the Gift tab advances your quest and raises her affection."
        }
      ]
    },
