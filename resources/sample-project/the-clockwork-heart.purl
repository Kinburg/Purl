{
  "id": "proj_clockwork_heart",
  "title": "The Clockwork Heart",
  "ifid": "PURL-DEMO-CLOCKWORK-HEART",
  "author": "Purl",
  "description": "A small steampunk visual novel demonstrating Purl block types.",
  "lore": "Cogsworth: a fog-wrapped harbor town run on brass and aether. The inventor Elara Voss is building a heart-engine to light the whole harbor.",
  "settings": {
    "storyLanguage": "English",
    "autoloadSave": false,
    "bgColor": "#0f172a",
    "audioUnlockText": "▶ Click to begin"
  },
  "scenes": [
    {
      "id": "sc_start",
      "name": "Start",
      "tags": [
        "start"
      ],
      "blocks": [
        {
          "id": "b_start_note",
          "type": "note",
          "text": "Opening scene. Sets player name, seeds world state, plays ambience."
        },
        {
          "id": "b_start_audio",
          "type": "audio",
          "src": "assets/audio/ambient_harbor.mp3",
          "trigger": "immediate",
          "loop": true,
          "onLeave": "persist",
          "stopOthers": false,
          "volume": 55
        },
        {
          "id": "b_start_callout",
          "type": "callout",
          "variant": "info",
          "title": "How to play",
          "content": "Click choices and links to move through the story. Your stats live in the sidebar."
        },
        {
          "id": "b_start_text",
          "type": "text",
          "content": "Steam hisses from the cobbled streets of **Cogsworth**. A telegram in your pocket reads only: //come quickly — E.//",
          "typewriter": {
            "speed": 25
          }
        },
        {
          "id": "b_start_input",
          "type": "input-field",
          "label": "What do they call you?",
          "variableId": "var_playername",
          "placeholder": "Traveler"
        },
        {
          "id": "b_start_world",
          "type": "set-object",
          "variableId": "var_worldstate",
          "entries": [
            {
              "id": "wo_town",
              "key": "townName",
              "valueType": "string",
              "value": "Cogsworth"
            },
            {
              "id": "wo_day",
              "key": "day",
              "valueType": "number",
              "value": "1"
            },
            {
              "id": "wo_fog",
              "key": "foggy",
              "valueType": "boolean",
              "value": "true"
            },
            {
              "id": "wo_exits",
              "key": "exits",
              "valueType": "array",
              "value": "[\"north\",\"docks\"]"
            },
            {
              "id": "wo_meta",
              "key": "meta",
              "valueType": "object",
              "entries": [
                {
                  "id": "wo_chapter",
                  "key": "chapter",
                  "valueType": "number",
                  "value": "1"
                }
              ]
            }
          ]
        },
        {
          "id": "b_start_save",
          "type": "save",
          "title": "Arrival",
          "notify": true,
          "notifyText": "Progress saved"
        },
        {
          "id": "b_start_divider",
          "type": "divider",
          "color": "#475569",
          "thickness": 1,
          "marginV": 12
        },
        {
          "id": "b_start_choice",
          "type": "choice",
          "options": [
            {
              "id": "o_start_go",
              "label": "Head into town",
              "targetSceneId": "sc_town",
              "condition": ""
            }
          ]
        },
        {
          "id": "b_start_popup",
          "type": "popup",
          "targetSceneId": "sc_pop_welcome",
          "title": "Welcome"
        }
      ]
    },
    {
      "id": "sc_town",
      "name": "TownSquare",
      "tags": [],
      "blocks": [
        {
          "id": "b_town_text",
          "type": "text",
          "content": "The town square churns with gears and gossip. Three lanes branch away from the fountain."
        },
        {
          "id": "b_town_time",
          "type": "time-manipulation",
          "variableId": "var_gametime",
          "years": 0,
          "months": 0,
          "days": 0,
          "hours": 1,
          "minutes": 0
        },
        {
          "id": "b_town_spacer",
          "type": "spacer",
          "size": 10
        },
        {
          "id": "b_town_links_section",
          "type": "section",
          "title": "Where to?",
          "blocks": [
            {
              "id": "b_town_l1",
              "type": "link",
              "label": "Elara's Workshop",
              "target": "scene",
              "targetSceneId": "sc_workshop",
              "actions": [],
              "style": {
                "bgColor": "#3b82f6",
                "textColor": "#fff",
                "borderColor": "#2563eb",
                "borderRadius": 6,
                "paddingV": 6,
                "paddingH": 14,
                "fontSize": 10,
                "bold": false,
                "fullWidth": false
              }
            },
            {
              "id": "b_town_l2",
              "type": "link",
              "label": "Doran's Emporium",
              "target": "scene",
              "targetSceneId": "sc_shop",
              "actions": [],
              "style": {
                "bgColor": "#d97706",
                "textColor": "#fff",
                "borderColor": "#b45309",
                "borderRadius": 6,
                "paddingV": 6,
                "paddingH": 14,
                "fontSize": 10,
                "bold": false,
                "fullWidth": false
              }
            },
            {
              "id": "b_town_l6",
              "type": "link",
              "label": "The Foggy Docks",
              "target": "scene",
              "targetSceneId": "sc_docks",
              "actions": [],
              "style": {
                "bgColor": "#334155",
                "textColor": "#fff",
                "borderColor": "#1e293b",
                "borderRadius": 6,
                "paddingV": 6,
                "paddingH": 14,
                "fontSize": 10,
                "bold": false,
                "fullWidth": false
              }
            },
            {
              "id": "b_town_l3",
              "type": "link",
              "label": "Your satchel & gear",
              "target": "scene",
              "targetSceneId": "sc_wardrobe",
              "actions": [],
              "style": {
                "bgColor": "#0d9488",
                "textColor": "#fff",
                "borderColor": "#0f766e",
                "borderRadius": 6,
                "paddingV": 6,
                "paddingH": 14,
                "fontSize": 10,
                "bold": false,
                "fullWidth": false
              }
            },
            {
              "id": "b_town_l4",
              "type": "link",
              "label": "Quest journal",
              "target": "scene",
              "targetSceneId": "sc_questlog",
              "actions": [],
              "style": {
                "bgColor": "#7c3aed",
                "textColor": "#fff",
                "borderColor": "#6d28d9",
                "borderRadius": 6,
                "paddingV": 6,
                "paddingH": 14,
                "fontSize": 10,
                "bold": false,
                "fullWidth": false
              }
            },
            {
              "id": "b_town_l5",
              "type": "link",
              "label": "Settings",
              "target": "scene",
              "targetSceneId": "sc_settings",
              "actions": [],
              "style": {
                "bgColor": "#475569",
                "textColor": "#fff",
                "borderColor": "#334155",
                "borderRadius": 6,
                "paddingV": 6,
                "paddingH": 14,
                "fontSize": 10,
                "bold": false,
                "fullWidth": false
              }
            }
          ]
        }
      ]
    },
    {
      "id": "sc_workshop",
      "name": "Workshop",
      "tags": [],
      "blocks": [
        {
          "id": "b_ws_img",
          "type": "image",
          "mode": "static",
          "src": "assets/chars/elara_full.png",
          "alt": "Elara at her workbench",
          "width": 320
        },
        {
          "id": "b_ws_set_met",
          "type": "variable-set",
          "variableId": "var_met_elara",
          "operator": "=",
          "value": "true"
        },
        {
          "id": "b_ws_dlg",
          "type": "dialogue",
          "characterId": "char_elara",
          "text": "You came! Oh — mind the springs. My heart-engine is //this// close, but it's missing a single copper gear.",
          "align": "left",
          "typewriter": {
            "speed": 20
          }
        },
        {
          "id": "b_ws_quest_guard",
          "type": "condition",
          "branches": [
            {
              "id": "br_ws_quest",
              "branchType": "if",
              "variableId": "qv_talk_state",
              "operator": "==",
              "value": "active",
              "blocks": [
                {
                  "id": "b_ws_quest",
                  "type": "quest-set",
                  "questId": "quest_missing",
                  "stepStates": [
                    {
                      "stepId": "qs_talk",
                      "state": "done"
                    },
                    {
                      "stepId": "qs_get",
                      "state": "active"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "b_ws_progress",
          "type": "progress",
          "variableId": "var_affection",
          "maxValue": 100,
          "color": "#a855f7",
          "emptyColor": "#312e81",
          "textColor": "#ede9fe",
          "colorRange": {
            "from": "#6366f1",
            "to": "#ec4899"
          },
          "showText": true,
          "height": 14
        },
        {
          "id": "b_ws_tabs",
          "type": "tabs",
          "defaultTabIndex": 0,
          "tabs": [
            {
              "id": "tab_talk",
              "label": "Talk",
              "blocks": [
                {
                  "id": "b_ws_talk_btn",
                  "type": "button",
                  "label": "Compliment her work (+5)",
                  "style": {
                    "bgColor": "#22c55e",
                    "textColor": "#06281a",
                    "borderColor": "#16a34a",
                    "borderRadius": 6,
                    "paddingV": 6,
                    "paddingH": 14,
                    "fontSize": 10,
                    "bold": false,
                    "fullWidth": false
                  },
                  "refreshScene": true,
                  "actions": [
                    {
                      "id": "a_aff",
                      "type": "set-variable",
                      "variableId": "var_affection",
                      "operator": "+=",
                      "value": "5"
                    }
                  ]
                },
                {
                  "id": "b_ws_cond",
                  "type": "condition",
                  "branches": [
                    {
                      "id": "br_high",
                      "branchType": "if",
                      "variableId": "var_affection",
                      "operator": ">=",
                      "value": "20",
                      "blocks": [
                        {
                          "id": "b_ws_cond_hi",
                          "type": "dialogue",
                          "characterId": "char_elara",
                          "text": "A warm smile. \"You always know what to say.\"",
                          "align": "left"
                        }
                      ]
                    },
                    {
                      "id": "br_low",
                      "branchType": "else",
                      "variableId": "",
                      "operator": "==",
                      "value": "",
                      "blocks": [
                        {
                          "id": "b_ws_cond_lo",
                          "type": "text",
                          "content": "She nods politely, eyes still on her gears."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "tab_gift",
              "label": "Gift",
              "blocks": [
                {
                  "id": "b_ws_gift_gear_cond",
                  "type": "condition",
                  "branches": [
                    {
                      "id": "br_gift_gear_yes",
                      "branchType": "if",
                      "variableId": "",
                      "operator": "==",
                      "value": "",
                      "rawExpression": "tgInvHas($traveler, \"gear\")",
                      "blocks": [
                        {
                          "id": "b_ws_gift_fn",
                          "type": "function",
                          "label": "Offer a copper gear",
                          "targetSceneId": "sc_give_gift",
                          "style": {
                            "bgColor": "#7c3aed",
                            "textColor": "#fff",
                            "borderColor": "#6d28d9",
                            "borderRadius": 6,
                            "paddingV": 6,
                            "paddingH": 14,
                            "fontSize": 10,
                            "bold": false,
                            "fullWidth": false
                          },
                          "actions": []
                        },
                        {
                          "id": "b_ws_gift_hint",
                          "type": "text",
                          "content": "//Giving the gear here advances your quest.//"
                        },
                        {
                          "id": "b_ws_gift_gear_spacer",
                          "type": "spacer",
                          "size": 10
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "b_ws_gift_rose_cond",
                  "type": "condition",
                  "branches": [
                    {
                      "id": "br_gift_rose_yes",
                      "branchType": "if",
                      "variableId": "",
                      "operator": "==",
                      "value": "",
                      "rawExpression": "tgInvHas($traveler, \"rose\")",
                      "blocks": [
                        {
                          "id": "b_ws_gift_rose_fn",
                          "type": "function",
                          "label": "Offer the Clockwork Rose",
                          "targetSceneId": "sc_give_rose",
                          "style": {
                            "bgColor": "#ec4899",
                            "textColor": "#fff",
                            "borderColor": "#db2777",
                            "borderRadius": 6,
                            "paddingV": 6,
                            "paddingH": 14,
                            "fontSize": 10,
                            "bold": false,
                            "fullWidth": false
                          },
                          "actions": []
                        },
                        {
                          "id": "b_ws_gift_rose_hint",
                          "type": "text",
                          "content": "//Offer the rare treasure found at the docks.//"
                        },
                        {
                          "id": "b_ws_gift_rose_spacer",
                          "type": "spacer",
                          "size": 10
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "b_ws_gift_none_cond",
                  "type": "condition",
                  "branches": [
                    {
                      "id": "br_gift_none_yes",
                      "branchType": "if",
                      "variableId": "",
                      "operator": "==",
                      "value": "",
                      "rawExpression": "!tgInvHas($traveler, \"gear\") && !tgInvHas($traveler, \"rose\")",
                      "blocks": [
                        {
                          "id": "b_ws_gift_none_text",
                          "type": "text",
                          "content": "You don't have any suitable gifts in your satchel right now. Elara needs a copper gear for her engine, but maybe you can find something else in Cogsworth..."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "tab_lore",
              "label": "Lore",
              "blocks": [
                {
                  "id": "b_ws_lore",
                  "type": "text",
                  "content": "The heart-engine, she explains, could power the whole harbor — if only it ticked."
                },
                {
                  "id": "b_ws_video",
                  "type": "video",
                  "src": "assets/vid/heart_engine.mp4",
                  "autoplay": false,
                  "loop": false,
                  "controls": true,
                  "width": 360
                }
              ]
            }
          ]
        },
        {
          "id": "b_ws_help",
          "type": "button",
          "label": "Help",
          "style": {
            "bgColor": "#334155",
            "textColor": "#cbd5e1",
            "borderColor": "#1e293b",
            "borderRadius": 6,
            "paddingV": 6,
            "paddingH": 14,
            "fontSize": 10,
            "bold": false,
            "fullWidth": false
          },
          "actions": [
            {
              "id": "a_help",
              "type": "open-popup",
              "targetSceneId": "sc_pop_help",
              "title": "How gifting works"
            }
          ]
        },
        {
          "id": "b_ws_back",
          "type": "link",
          "label": "Return to town",
          "target": "scene",
          "targetSceneId": "sc_town",
          "actions": [],
          "style": {
            "bgColor": "#475569",
            "textColor": "#fff",
            "borderColor": "#334155",
            "borderRadius": 6,
            "paddingV": 6,
            "paddingH": 14,
            "fontSize": 10,
            "bold": false,
            "fullWidth": false
          }
        }
      ]
    },
    {
      "id": "sc_shop",
      "name": "Emporium",
      "tags": [],
      "blocks": [
        {
          "id": "b_shop_dlg",
          "type": "dialogue",
          "characterId": "char_doran",
          "text": "Welcome, welcome! Gears, lanterns, tonics — I've got just the thing.",
          "align": "right"
        },
        {
          "id": "b_shop_container",
          "type": "container",
          "containerId": "cont_emporium",
          "title": "Doran's Emporium"
        },
        {
          "id": "b_shop_quest_guard",
          "type": "condition",
          "branches": [
            {
              "id": "br_shop_quest",
              "branchType": "if",
              "variableId": "qv_get_state",
              "operator": "==",
              "value": "active",
              "blocks": [
                {
                  "id": "b_shop_quest",
                  "type": "quest-set",
                  "questId": "quest_missing",
                  "stepStates": [
                    {
                      "stepId": "qs_get",
                      "state": "done"
                    },
                    {
                      "stepId": "qs_return",
                      "state": "active"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "b_shop_divider",
          "type": "divider"
        },
        {
          "id": "b_shop_links",
          "type": "link",
          "label": "Return to the workshop",
          "target": "scene",
          "targetSceneId": "sc_workshop",
          "actions": [],
          "style": {
            "bgColor": "#3b82f6",
            "textColor": "#fff",
            "borderColor": "#2563eb",
            "borderRadius": 6,
            "paddingV": 6,
            "paddingH": 14,
            "fontSize": 10,
            "bold": false,
            "fullWidth": false
          }
        },
        {
          "id": "b_shop_back",
          "type": "link",
          "label": "Return to town",
          "target": "scene",
          "targetSceneId": "sc_town",
          "actions": [],
          "style": {
            "bgColor": "#475569",
            "textColor": "#fff",
            "borderColor": "#334155",
            "borderRadius": 6,
            "paddingV": 6,
            "paddingH": 14,
            "fontSize": 10,
            "bold": false,
            "fullWidth": false
          }
        }
      ]
    },
    {
      "id": "sc_docks",
      "name": "Docks",
      "tags": [],
      "blocks": [
        {
          "id": "b_docks_note",
          "type": "note",
          "text": "Docks scene. Checks for equipped Aether Lantern."
        },
        {
          "id": "b_docks_cond",
          "type": "condition",
          "branches": [
            {
              "id": "br_docks_light",
              "branchType": "if",
              "variableId": "",
              "operator": "==",
              "value": "",
              "rawExpression": "tgIsEquipped($traveler, \"lantern\")",
              "blocks": [
                {
                  "id": "b_docks_light_text",
                  "type": "text",
                  "content": "The bright blue-white beam of your Aether Lantern cuts through the thick green smog. You walk along the creaking timber pier. Near a rusted, derelict crane, you spot a pile of discarded clockwork scrap. Something gold glints deep within the heap."
                },
                {
                  "id": "b_docks_debris_container",
                  "type": "container",
                  "containerId": "cont_debris",
                  "title": "Rusted Debris"
                }
              ]
            },
            {
              "id": "br_docks_dark",
              "branchType": "else",
              "variableId": "",
              "operator": "==",
              "value": "",
              "blocks": [
                {
                  "id": "b_docks_dark_text",
                  "type": "text",
                  "content": "The thick green fog wraps around the harbor like a wet shroud. You hear waves lapping against the timber piers, but you can't see two steps in front of you. Exploring the docks in this blackness is suicide. You need a light source to pierce this gloom — perhaps Doran at the Emporium has something?"
                },
                {
                  "id": "b_docks_purse_cond",
                  "type": "condition",
                  "branches": [
                    {
                      "id": "br_purse_found",
                      "branchType": "if",
                      "variableId": "",
                      "operator": "==",
                      "value": "",
                      "rawExpression": "$foundPurse",
                      "blocks": [
                        {
                          "id": "b_docks_purse_text",
                          "type": "text",
                          "content": "You have already recovered the soggy leather pouch containing 40 gold coins."
                        }
                      ]
                    },
                    {
                      "id": "br_purse_not_found",
                      "branchType": "else",
                      "variableId": "",
                      "operator": "==",
                      "value": "",
                      "blocks": [
                        {
                          "id": "b_docks_grope_btn",
                          "type": "button",
                          "label": "Grope blindly in the dark water",
                          "style": {
                            "bgColor": "#d97706",
                            "textColor": "#fff",
                            "borderColor": "#b45309",
                            "borderRadius": 6,
                            "paddingV": 6,
                            "paddingH": 14,
                            "fontSize": 10,
                            "bold": false,
                            "fullWidth": false
                          },
                          "refreshScene": true,
                          "actions": [
                            {
                              "id": "a_purse_set",
                              "type": "set-variable",
                              "variableId": "var_found_purse",
                              "operator": "=",
                              "value": "true"
                            },
                            {
                              "id": "a_purse_gold",
                              "type": "set-variable",
                              "variableId": "cv_traveler_money",
                              "operator": "+=",
                              "value": "40"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "b_docks_back",
          "type": "link",
          "label": "Return to Town Square",
          "target": "scene",
          "targetSceneId": "sc_town",
          "actions": [],
          "style": {
            "bgColor": "#475569",
            "textColor": "#fff",
            "borderColor": "#334155",
            "borderRadius": 6,
            "paddingV": 6,
            "paddingH": 14,
            "fontSize": 10,
            "bold": false,
            "fullWidth": false
          }
        }
      ]
    },
    {
      "id": "sc_wardrobe",
      "name": "Satchel",
      "tags": [],
      "blocks": [
        {
          "id": "b_wd_text",
          "type": "text",
          "content": "You lay out your belongings and the gear you carry."
        },
        {
          "id": "b_wd_paperdoll",
          "type": "paperdoll",
          "charId": "char_traveler",
          "showLabels": true
        },
        {
          "id": "b_wd_inv",
          "type": "inventory",
          "charId": "char_traveler",
          "title": "Satchel"
        },
        {
          "id": "b_wd_for",
          "type": "for",
          "mode": "range",
          "valueVar": "_member",
          "source": "$partyMembers",
          "blocks": [
            {
              "id": "b_wd_for_text",
              "type": "text",
              "content": "• <<print _member>>"
            }
          ]
        },
        {
          "id": "b_wd_use",
          "type": "function",
          "label": "Drink a Healing Tonic",
          "targetSceneId": "sc_use_tonic",
          "style": {
            "bgColor": "#16a34a",
            "textColor": "#fff",
            "borderColor": "#15803d",
            "borderRadius": 6,
            "paddingV": 6,
            "paddingH": 14,
            "fontSize": 10,
            "bold": false,
            "fullWidth": false
          },
          "actions": []
        },
        {
          "id": "b_wd_back",
          "type": "link",
          "label": "Return to town",
          "target": "scene",
